# Copy outside the repository/web server root and fill locally. See setup guide.
# Do not send secrets in chat. .env.local is ignored as a fallback, not for serving.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by hosted Edge Functions.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Merchant ID of the separate SELLER sandbox account
PAYPAL_SANDBOX_MERCHANT_ID=
# Supabase Authentication > Users > User UID (not the PayPal account ID).
PAYPAL_SANDBOX_TEST_USER_IDS=
# Exact origins, no trailing slash. Paths do not belong here.
PAYPAL_SANDBOX_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Merchant ID of the PLATFORM sandbox account
PAYPAL_SANDBOX_PARTNER_ID=
# Partner attribution / BN code for your Platform Partner App
PAYPAL_SANDBOX_BN_CODE=
